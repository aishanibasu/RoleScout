# Optional absolute path to the local database. Leave unset for backend/data/roles.sqlite3.
# ROLE_SEARCHER_DB=/absolute/path/to/roles.sqlite3

# Optional Google Sheets connection. Register a Web application OAuth client.
# Enable the Google Sheets API and add this exact authorized redirect URI.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/sheets/callback
